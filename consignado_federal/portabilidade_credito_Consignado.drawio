  <diagram name="Assinatura da Proposta - Critério de aceite" id="Gz2FniD2fLZ3Gvlrhqgn">
    <mxGraphModel grid="0" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="NroOX7YLj7dFU-Pt5fzj-0" />
        <mxCell id="NroOX7YLj7dFU-Pt5fzj-1" parent="NroOX7YLj7dFU-Pt5fzj-0" />
        <mxCell id="NroOX7YLj7dFU-Pt5fzj-2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillStyle=solid;fontSize=18;arcSize=5;fillColor=#dae8fc;strokeColor=default;opacity=20;" vertex="1" parent="NroOX7YLj7dFU-Pt5fzj-1">
          <mxGeometry x="52" y="1671" width="609" height="282" as="geometry" />
        </mxCell>
        <mxCell id="NroOX7YLj7dFU-Pt5fzj-3" value="&lt;p&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;- Deve ser confirmado internamente&lt;/span&gt;&lt;strong style=&quot;background-color: initial;&quot;&gt; se o cliente realizou o consentimento &lt;/strong&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;para a instituição proponente acessar os dados do contrato na instituição credora.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;/p&gt;&lt;p&gt;- Deve ser &lt;strong&gt;exibido para o cliente as condições do novo contrato&lt;/strong&gt; gerado pela instituição proponente.&lt;/p&gt;&lt;p&gt;&lt;/p&gt;&lt;p&gt;- O cliente &lt;strong&gt;deve ter a opção de revisar e dar o aceite&lt;/strong&gt; a proposta apresentada.&lt;/p&gt;&lt;p&gt;&lt;/p&gt;&lt;p&gt;- A &lt;strong&gt;solicitação&lt;/strong&gt; de portabilidade de crédito só &lt;strong&gt;deve seguir após o aceite do cliente.&lt;/strong&gt;&lt;/p&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;spacingLeft=5;fontColor=#333333;fontSize=18;verticalAlign=top;spacingTop=-15;arcSize=5;" vertex="1" parent="NroOX7YLj7dFU-Pt5fzj-1">
