        <UserObject label="Consulta dos contrato de empréstimos" id="GAiBQvnHzR4Qv7I_gg-6-41">
          <mxCell style="dashed=0;html=1;rounded=1;strokeColor=#083F75;fontSize=12;align=center;fontStyle=1;strokeWidth=2;fontColor=#FFFFFF;fillColor=#083F75;" parent="GAiBQvnHzR4Qv7I_gg-6-1" vertex="1">
            <mxGeometry x="1675" y="566" width="249" height="20" as="geometry" />
          </mxCell>
        </UserObject>
        <mxCell id="GAiBQvnHzR4Qv7I_gg-6-42" value="" style="verticalLabelPosition=bottom;verticalAlign=top;html=1;strokeWidth=2;shape=mxgraph.arrows2.arrow;dy=0.57;dx=12.05;notch=0;strokeColor=#083F75;fontColor=#FFFFFF;fillColor=none;" parent="GAiBQvnHzR4Qv7I_gg-6-1" vertex="1">
          <mxGeometry x="1646" y="570" width="21" height="12" as="geometry" />
        </mxCell>
        <mxCell id="GAiBQvnHzR4Qv7I_gg-6-44" value="" style="rounded=0;whiteSpace=wrap;html=1;fillStyle=solid;fontSize=18;arcSize=5;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=20;" parent="GAiBQvnHzR4Qv7I_gg-6-1" vertex="1">
          <mxGeometry x="714" y="614" width="1338" height="1127" as="geometry" />
        </mxCell>
        <mxCell id="GAiBQvnHzR4Qv7I_gg-6-49" value="Parecer GT" style="dashed=0;html=1;rounded=1;strokeColor=none;fontSize=12;align=center;fontStyle=1;strokeWidth=2;fillColor=#dae8fc;" parent="GAiBQvnHzR4Qv7I_gg-6-1" vertex="1">
          <mxGeometry x="714" y="614" width="111" height="20" as="geometry" />
        </mxCell>
        <mxCell id="MO9DpvA7yBtufRPZfp8_-0" value="&lt;p&gt;A consulta será realizada através de chamadas na API de Empréstimos (Dados do Cliente), a fim de auxiliar instituições proponentes na composição de propostas de portabilidade de crédito, conforme descrito abaixo:&lt;/p&gt;&lt;p&gt;&amp;nbsp;&lt;/p&gt;&lt;p&gt;Ajustes:&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Endpoint: /contracts/{contractId}&lt;/li&gt;&lt;/ul&gt;&lt;p style=&quot;margin-left: 40px;&quot;&gt;Campo / Objeto: dueDate&lt;/p&gt;&lt;p style=&quot;margin-left: 40px;&quot;&gt;Recomendação: Clarificar descrição do campo onde deve ser informado a data do&lt;/p&gt;&lt;p style=&quot;margin-left: 40px;&quot;&gt;último vencimento, especialmente útil para contratos repactuados&lt;/p&gt;&lt;p style=&quot;margin-left: 40px;&quot;&gt;(se houver)&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Endpoint: /contracts/{contractId}&lt;/li&gt;&lt;/ul&gt;&lt;p style=&quot;margin-left: 40px;&quot;&gt;Campo / Objeto: interestRates&lt;/p&gt;&lt;p style=&quot;margin-left: 40px;&quot;&gt;Recomendação: Ajustes na documentação para orientar aos participantes que, para&lt;/p&gt;&lt;p style=&quot;margin-left: 40px;&quot;&gt;o Produto CPC, devem conter a taxa nominal e efetiva com a periodicidade em a.a. (ao ano) podendo também incluir valores em uma periodicidade diferente como um adicional.&lt;/p&gt;&lt;p style=&quot;margin-left: 40px;&quot;&gt;&amp;nbsp;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Endpoint: /contracts/{contractId}&lt;/li&gt;&lt;/ul&gt;&lt;p style=&quot;margin-left: 40px;&quot;&gt;Campo / Objeto: InterestRates.postFixedRate&lt;/p&gt;&lt;p style=&quot;margin-left: 40px;&quot;&gt;Recomendação: Realizar ajuste da descrição, que se o índice da taxa for pós fixado,&lt;/p&gt;&lt;p style=&quot;margin-left: 40px;&quot;&gt;será necessário informar o indexador atrelado.&lt;/p&gt;&lt;p style=&quot;margin-left: 40px;&quot;&gt;&amp;nbsp;&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Endpoint: /contracts/{contractId}/payments&lt;/li&gt;&lt;/ul&gt;&lt;p style=&quot;margin-left: 40px;&quot;&gt;Campo / Objeto: -&lt;/p&gt;&lt;p style=&quot;margin-left: 40px;&quot;&gt;Recomendação: Adicionar campo de data e hora da atualização do campo contractOutstandingBalance (esta informação será útil pois a Instituição Proponente poderá usar o campo para elaborar uma proposta ou até mesmo para liquidar um contrato a ser portado e ter o valor atualizado na data correta)&lt;/p&gt;&lt;p&gt;&amp;nbsp;&lt;/p&gt;&lt;p&gt;Novo campo&lt;/p&gt;&lt;ul&gt;&lt;li&gt;Endpoint: /contracts/{contractId}&lt;/li&gt;&lt;/ul&gt;&lt;p style=&quot;margin-left: 40px;&quot;&gt;Campo / Objeto: valor da parcela&lt;/p&gt;&lt;p&gt;&lt;span data-teams=&quot;true&quot;&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;font-size: inherit;&quot;&gt;Recomendação: Inclusão do novo campo.&lt;/span&gt;&lt;/p&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;spacingLeft=5;fontColor=#000000;fontSize=18;verticalAlign=top;spacingTop=-15;arcSize=5;" vertex="1" parent="GAiBQvnHzR4Qv7I_gg-6-1">
          <mxGeometry x="730" y="639" width="1304" height="1092" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
