        <UserObject label="&lt;span style=&quot;font-family: &amp;quot;Helvetica Neue&amp;quot;;&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;b style=&quot;border-color: var(--border-color); font-family: &amp;quot;Helvetica Neue&amp;quot;;&quot;&gt;Cenário 2:&lt;/b&gt;&lt;span style=&quot;font-family: &amp;quot;Helvetica Neue&amp;quot;;&quot;&gt;&amp;nbsp;Cliente aceita contraproposta da Credora dentro dos 3 dias uteis&lt;/span&gt;" link="data:page/id,qZ_YGOxYiJbcYd9rZF7v" id="lIR5RVceTkiswlwexQ6Z-2">
          <mxCell style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;textShadow=0;shadow=1;align=left;spacingLeft=5;fillStyle=solid;fontSize=18;" vertex="1" parent="Yq1XORfycZsZseIXgy6u-1">
            <mxGeometry x="-140.34" y="2956" width="359" height="62" as="geometry" />
          </mxCell>
        </UserObject>
