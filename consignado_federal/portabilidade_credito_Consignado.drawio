  <diagram name="Validação do consentimento - Parecer GT" id="YthxU4lcDVxAYfw8ejb1">
    <mxGraphModel dx="792" dy="-386" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="xYUQwrPciGZdBROAaZPy-0" />
        <mxCell id="xYUQwrPciGZdBROAaZPy-1" parent="xYUQwrPciGZdBROAaZPy-0" />
        <mxCell id="xYUQwrPciGZdBROAaZPy-2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillStyle=solid;fontSize=18;arcSize=5;fillColor=#dae8fc;strokeColor=default;opacity=20;" parent="xYUQwrPciGZdBROAaZPy-1" vertex="1">
          <mxGeometry x="252" y="1161" width="824" height="241" as="geometry" />
        </mxCell>
        <mxCell id="xYUQwrPciGZdBROAaZPy-3" value="&lt;ul&gt;&lt;li&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;Quando o cliente&amp;nbsp;&lt;b&gt;realizou o consentimento contemplando dados de operação de crédito&lt;/b&gt;, não será necessário fornecer um novo consentimento;&amp;nbsp;&lt;/span&gt;&lt;/li&gt;&lt;li&gt;Quando o cliente&amp;nbsp;&lt;b&gt;realizou o consentimento não contemplando dados da operação&amp;nbsp;&lt;/b&gt;OU ainda&amp;nbsp;&lt;b&gt;não forneceu o consentimento&lt;/b&gt;, será necessário realizar o consentimento.&amp;nbsp;&lt;/li&gt;&lt;/ul&gt;&lt;p&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;br&gt;&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;&lt;b&gt;Obs.:&lt;/b&gt;&amp;nbsp;A instituição receptora dos dados deve sempre assegurar que o escopo dos dados acessados esteja adequado à finalidade do uso, conforme o art. 12 da Resolução Conjunta nº 1&amp;nbsp;&lt;/span&gt;&lt;/p&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;spacingLeft=5;fontColor=#000000;fontSize=18;verticalAlign=top;spacingTop=-15;arcSize=5;" parent="xYUQwrPciGZdBROAaZPy-1" vertex="1">
