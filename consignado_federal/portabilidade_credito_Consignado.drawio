  <diagram name="Validação da Liquidação - Criterio de aceite" id="68rOikBMmQMq6z3L39Ex">
    <mxGraphModel grid="0" page="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="Q3zF-v94c47tfJR0SZGb-0" />
        <mxCell id="Q3zF-v94c47tfJR0SZGb-1" parent="Q3zF-v94c47tfJR0SZGb-0" />
        <mxCell id="sx2tfyYy3e3fQFaIpZ_V-0" value="" style="rounded=0;whiteSpace=wrap;html=1;fillStyle=solid;fontSize=18;arcSize=5;fillColor=#dae8fc;strokeColor=#6c8ebf;opacity=20;" vertex="1" parent="Q3zF-v94c47tfJR0SZGb-1">
          <mxGeometry x="-116" y="2624" width="1073" height="216" as="geometry" />
        </mxCell>
        <mxCell id="Q3zF-v94c47tfJR0SZGb-14" value="&lt;p&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;1. Ao receber as informações da instituição credora, a instituição proponente deve realizar o &lt;/span&gt;&lt;strong style=&quot;background-color: initial;&quot;&gt;pagamento no mesmo dia&lt;/strong&gt;&lt;span style=&quot;background-color: initial;&quot;&gt;.&lt;/span&gt;&lt;/p&gt;&lt;p&gt;&lt;/p&gt;&lt;p&gt;2. A notificação para a instituição credora deve &lt;strong&gt;incluir o comprovante de pagamento &lt;/strong&gt;(payload sugerido) e ser enviada no mesmo dia do pagamento.&lt;/p&gt;&lt;p&gt;&lt;/p&gt;&lt;p&gt;3. A instituição credora deve &lt;strong&gt;confirmar o recebimento&lt;/strong&gt; do pagamento e &lt;strong&gt;enviar um documento&lt;/strong&gt; que comprove a liquidação da operação em até 2 dias úteis após a notificação.&lt;/p&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=none;align=left;spacingLeft=5;fontColor=#333333;fontSize=18;verticalAlign=top;spacingTop=0;" vertex="1" parent="Q3zF-v94c47tfJR0SZGb-1">
